+        throw std::runtime_error("ROI fixed-header contract violated");
+      auto header=ram;
+      for(int i=0x1C;i<=0x22;++i)header[i]=0;header[0x64]=header[0x66]=0;
+      if(cachedX!=ram[0x66] || cachedY!=ram[0x64] || cachedHeader!=header) {
+        myConsole.tia().fbEnabled=false;initial.rewind();if(!mySystem.load(initial))throw std::runtime_error("ROI initial restore failed");
+        for(int i=0;i<128;++i)mySystem.pokeOob(0x80+i,ram[i]);
+        until(0xF0DF);cachedBase=mySystem.peek(0x89)|(mySystem.peek(0x8A)<<8);
+        myConsole.tia().fbBegin(cachedBase);until(0xF263);
+        unlockSystem();mySystem.m6502().execute(1);lockSystem();until(0xF263);
+        roi=std::make_unique<Serializer>();if(!mySystem.save(*roi))throw std::runtime_error("ROI save failed");
+        cachedX=ram[0x66];cachedY=ram[0x64];cachedHeader=header;cachedVirtual=myConsole.tia().fbSavePrefix();
+      }
+      myConsole.tia().fbEnabled=false;roi->rewind();if(!mySystem.load(*roi))throw std::runtime_error("ROI restore failed");
+      for(int a=0x9C;a<=0xA2;++a)mySystem.pokeOob(a,ram[a-128]);
+      myConsole.tia().fbRestorePrefix(cachedVirtual);until(0xF3C4);
+      writeBits(myConsole.tia().fbTruthResponses[3]);writeBits(myConsole.tia().fbTruthBaseResponses[3]);
+      out.put(mySystem.peek(0xB6));for(int i=0;i<19;++i)out.put(mySystem.peek(cachedBase+i));
+      if(!out)throw std::runtime_error("ROI write failed");++count;continue;
+    }
+    myConsole.tia().fbEnabled=false;initial.rewind();
+    if(!mySystem.load(initial))throw std::runtime_error("probe restore failed");
+    for(int i=0;i<128;++i)mySystem.pokeOob(0x80+i,ram[i]);
+    for(int i=0;i<128;++i)if(mySystem.peek(0x80+i)!=ram[i])throw std::runtime_error("probe RAM identity failed");
+    until(0xF0DF);
+    const auto base=mySystem.peek(0x89)|(mySystem.peek(0x8A)<<8);
+    myConsole.tia().fbBegin(base);until(0xF476);
+    for(int row=0;row<4;++row){writeBits(myConsole.tia().fbTruthResponses[row]);writeBits(myConsole.tia().fbTruthBaseResponses[row]);}
+    for(int i=0;i<128;++i)out.put(mySystem.peek(0x80+i));
+    out.put(myCpuDebug->a());out.put(myCpuDebug->x());out.put(myCpuDebug->y());
+    out.put(0x20|(myCpuDebug->n()<<7)|(myCpuDebug->v()<<6)|(myCpuDebug->b()<<4)|(myCpuDebug->d()<<3)|(myCpuDebug->i()<<2)|(myCpuDebug->z()<<1)|myCpuDebug->c());out.put(myCpuDebug->sp());
+    for(int i=0;i<19;++i)out.put(mySystem.peek(base+i));
