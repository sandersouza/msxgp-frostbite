+    ++count;
+  }
+  myConsole.tia().fbEnabled=false;
+  if(in.gcount()!=0 || count==0)throw std::runtime_error("probe input must contain complete nonempty128-byte records");
+  out.flush();if(!out)throw std::runtime_error("probe final output write failed");
