+void Debugger::fbProbe()
+{
+  const char* input=std::getenv("FROSTBITE_PROBE_INPUT");
+  const char* output=std::getenv("FROSTBITE_PROBE_OUTPUT");
+  if(!input || !output)throw std::runtime_error("probe paths absent");
