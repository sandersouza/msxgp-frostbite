+void TIA::fbTruthStart()
+{
+  if(!fbTruthReady) {
+    for(int pose=0;pose<6;++pose)for(int shift=0;shift<19;++shift)for(int reflect=0;reflect<2;++reflect) {
+      const int view=pose*38+shift*2+reflect;
+      const int low=(mySystem->peek(0xFCAA+pose)+shift)&255;
+      if(low+18>=256)throw std::runtime_error("virtual glyph page crossing");
+      for(int row=0;row<19;++row) {
+        uInt8 value=mySystem->peek(0xFC00+low+row);
+        if(reflect){uInt8 reversed=0;for(int i=0;i<8;++i)reversed|=((value>>i)&1)<<(7-i);value=reversed;}
+        fbTruthPlanes[view][row]=value;
+        for(int bit=0;bit<8;++bit)if(value&(128>>bit))fbTruthPixelBits[row][bit].set(view);
+      }
+      (reflect?fbTruthOdd:fbTruthEven).set(view);
+    }
+    for(int a=0;a<20;++a)for(int b=0;b<20;++b)for(int view=0;view<228;++view)
+      if((a==19?0:fbTruthPlanes[view][a])==(b==19?0:fbTruthPlanes[view][b]))fbTruthEq[a][b].set(view);
+    fbTruthReady=true;
+  }
+  fbTruthCapturing=true;fbTruthWindow=false;
+  myPlayer0.fbTruthReset();fbTruthScheduled.reset();fbTruthEvents.reset();
+  fbTruthAllScheduled=fbTruthAllEvents=false;fbTruthP1.reset();fbTruthM1.reset();fbTruthP1Sample.reset();fbTruthM1P1.reset();
+  for(auto& row:fbTruthResponses)row.reset();
+  for(auto& row:fbTruthBaseResponses)row.reset();
+}
+TIA::FbBits TIA::fbTruthPixels(int tag,uInt8 value,uInt8 sample)
+{
+  if(tag>=0 && tag<19)return fbTruthPixelBits[tag][sample];
+  FbBits bits;
+  if(value&(128>>sample))bits|=fbTruthEven;
+  if(value&(1<<sample))bits|=fbTruthOdd;
+  return bits;
+}
+TIA::FbBits TIA::fbTruthEquals(int tag,uInt8 value,int other,uInt8 otherValue)
+{
+  if((tag>=0 || value==0) && (other>=0 || otherValue==0))return fbTruthEq[tag>=0?tag:19][other>=0?other:19];
+  FbBits result;
+  for(int view=0;view<228;++view) {
+    const auto reverse=[](uInt8 v){uInt8 r=0;for(int i=0;i<8;++i)r|=((v>>i)&1)<<(7-i);return r;};
+    const auto a=tag>=0?fbTruthPlanes[view][tag]:view&1?reverse(value):value;
+    const auto b=other>=0?fbTruthPlanes[view][other]:view&1?reverse(otherValue):otherValue;
+    if(a==b)result.set(view);
+  }
+  return result;
+}
+void TIA::fbTruthObserve()
+{
+  if(!fbTruthCapturing || !fbTruthWindow)return;
+  const bool p1=myPlayer1.isOn(),m1=myMissile1.isOn();if(!p1 && !m1)return;
+  if(p1 && m1){if(fbTruthAllEvents)fbTruthM1P1.set();else fbTruthM1P1|=fbTruthEvents;}
+  if(myPlayer0.fbVOn.none())return;
+  auto bits=myPlayer0.fbVOn;if(!fbTruthAllEvents)bits&=fbTruthEvents;
+  if(p1)fbTruthP1|=bits;if(m1)fbTruthM1|=bits;
+}
