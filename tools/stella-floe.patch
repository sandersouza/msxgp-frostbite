+    myPlayer0.fbVNewConst,myPlayer0.fbVOldConst,myPlayer0.fbVOn,fbTruthScheduled,fbTruthEvents,
+    fbTruthP1,fbTruthM1,fbTruthP1Sample,fbTruthM1P1,fbTruthAllScheduled,fbTruthAllEvents,
+    fbTruthCapturing,fbTruthWindow,fbTruthResponses,fbTruthBaseResponses};
+}
+void TIA::fbRestorePrefix(const FbPrefix& s)
+{
+  fbEnabled=true;fbGlyphBase=s.glyphBase;fbPendingTag=s.pendingTag;
+  myPlayer0.fbTruthActive=true;myPlayer0.fbNewTag=s.incomingTag;
+  myPlayer0.fbVNewTag=s.newTag;myPlayer0.fbVOldTag=s.oldTag;
+  myPlayer0.fbVNewConst=s.newConst;myPlayer0.fbVOldConst=s.oldConst;myPlayer0.fbVOn=s.on;
+  fbTruthScheduled=s.scheduled;fbTruthEvents=s.events;fbTruthP1=s.p1;fbTruthM1=s.m1;
+  fbTruthP1Sample=s.p1sample;fbTruthM1P1=s.m1p1;fbTruthAllScheduled=s.allScheduled;fbTruthAllEvents=s.allEvents;
+  fbTruthCapturing=s.capturing;fbTruthWindow=s.window;fbTruthResponses=s.responses;fbTruthBaseResponses=s.baseResponses;
+}
